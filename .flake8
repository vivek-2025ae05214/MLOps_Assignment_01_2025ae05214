[flake8]
# Flake8 configuration for MLOps Assignment 01

# Maximum line length
max-line-length = 127

# Complexity threshold
max-complexity = 10

# Exclude patterns
exclude = 
    .github
    .ipynb_checkpoints
    __pycache__
    .venv
    venv

# Ignore specific error codes
ignore = 
    E203,
    E501,
    W503
# Select specific error codes
select = E9,F63,F7,F82

# Show source code
show-source = True

# Show statistics
statistics = True
